# Nyaya — Legal Co-Pilot Hybrid Environment Configuration

# 1. Server Port & Data Directory
PORT=4173
# Optional: override SQLite & ledger directory (auto-detects /home/data on Azure App Service)
# NYAYA_DATA_DIR=

# 2. Default LLM Provider Gateway Mode
# Options:
# - "copilot-local": Uses your local `gh auth token` (great for founder dogfooding & local dev)
# - "ollama":        Uses your MacBook M1 Max 64GB RAM running Ollama (`http://127.0.0.1:11434` or LAN IP) for ₹0.00 cost
# - "azure-foundry": Uses your $150/month Microsoft Employee Visual Studio Enterprise credit on Azure AI Foundry
# - "gemini":        Uses Google AI Studio Free Tier (`GEMINI_API_KEY` — 1,500 free Vision/PDF calls/day)
# - "openrouter":    Uses OpenRouter (`OPENROUTER_API_KEY` for Claude + Gemini + GPT + DeepSeek)
# - "openai":        Uses OpenAI / Groq / any OpenAI-compatible endpoint
LLM_PROVIDER=copilot-local

# 3. MacBook M1 Max (64GB RAM) / Local Ollama Settings (₹0 Forever)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=deepseek-r1:32b

# 4. Microsoft Employee $150/mo Azure AI Foundry Settings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# 5. Google AI Studio Free Tier & OpenRouter Settings
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
